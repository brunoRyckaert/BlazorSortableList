@using Microsoft.JSInterop

@inject IJSRuntime JS

@typeparam T

<div id="@Id" style ="@Style" @attributes="Attributes">
    @foreach (var item in Items)
    {
        if (SortableItemTemplate is not null)
        {
            <div @key=Guid.NewGuid()>
                @SortableItemTemplate(item)
            </div>
        }
    }
</div>
